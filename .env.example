# PostgreSQL connection string (supports pgbouncer pooling via Neon)
DATABASE_URL="postgresql://neondb_owner:password@ep-host-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Secret used for session cookies / authentication tokens
SESSION_SECRET="super-secret-session-key-minimum-32-chars-long"
NEXTAUTH_SECRET="super-secret-session-key-minimum-32-chars-long"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Google Gemini API credentials for AI flyer and event parsing
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"

# Optional search key
TAVILY_API_KEY=""
