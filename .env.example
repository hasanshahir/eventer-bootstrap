# PostgreSQL connection string (supports pgbouncer pooling)
DATABASE_URL="postgresql://postgres:password@localhost:5432/eventer?schema=public&pgbouncer=true"

# Secret used for session cookies / authentication tokens
SESSION_SECRET="super-secret-session-key-minimum-32-chars-long"

# Google Gemini API credentials for AI flyer and event parsing
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
