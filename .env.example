# ==============================================================================
# Eventr — Environment Variables Configuration (.env.example)
# Copy to .env for local development. Never commit real credentials.
# ==============================================================================

# 1. PostgreSQL Database (Neon Pooled + Direct Connection for Prisma Migrate)
DATABASE_URL="postgresql://fake_user:fake_password@ep-fake-pooler.us-east-2.aws.neon.tech/eventr_dev?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://fake_user:fake_password@ep-fake-direct.us-east-2.aws.neon.tech/eventr_dev?sslmode=require"

# 2. Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Authentication (Auth.js v5 — minimum 32 random characters)
AUTH_SECRET="replace-with-32-byte-hex-secret-from-openssl-rand-hex-32"
AUTH_URL="http://localhost:3000"

# 4. Google OAuth 2.0 Credentials (optional locally if using Magic Link)
AUTH_GOOGLE_ID="000000000000-fakegoogleclientid.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-fake_google_client_secret_placeholder"

# 5. Transactional Email (Resend — for Magic Link sign-in & ticket confirmations)
RESEND_API_KEY="re_fake_resend_api_key_placeholder"
EMAIL_FROM="Eventr Dispatch <noreply@example.com>"
# Set to "true" in local/E2E tests to write magic links to .tmp/test-emails.json instead of calling Resend
AUTH_TEST_TRANSPORT="false"

# 6. Initial Admin Seed Account (used by `npm run db:seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Eventr Admin"

# 7. Security & Cryptography Secrets (minimum 32 characters each)
# Signs attendee QR pass JWTs (HS256 via jose)
TICKET_SIGNING_SECRET="replace-with-32-byte-ticket-signing-secret-placeholder"
# Encrypts User.phoneEncrypted at rest (AES-256-GCM)
PII_ENCRYPTION_KEY="replace-with-32-byte-pii-encryption-key-placeholder"
# Authorizes scheduled ingestion (`Authorization: Bearer <CRON_SECRET>`)
CRON_SECRET="replace-with-32-byte-cron-bearer-secret-placeholder"

# 8. Google Gemini API (Multimodal Event Flyer Parser)
GEMINI_API_KEY="AIzaSyFakeGeminiApiKeyPlaceholder0000000"
# Current supported Flash-class model (e.g. gemini-3.8-flash or gemini-2.5-flash; never retired gemini-1.5-flash)
GEMINI_MODEL="gemini-3.8-flash"

# 9. Rate Limiting (Upstash Redis — falls back to in-memory limiter with warning if unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 10. Bot Protection (Cloudflare Turnstile — enforced on RSVP and Event Submission when set)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# 11. Error Monitoring (Sentry — enabled when SENTRY_DSN is set)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
